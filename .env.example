# ── Провайдер ИИ ─────────────────────────────────────────────────────────────
# По умолчанию используется DeepSeek (дёшево для тестов). Чтобы вернуть Gemini —
# выставьте AFINA_AI_PROVIDER=google. Без ключа активного провайдера приложение
# работает по regex-fallback.
# AFINA_AI_PROVIDER: deepseek (дефолт) | google
AFINA_AI_PROVIDER=deepseek

# DeepSeek — ключ с platform.deepseek.com. Модель по умолчанию: deepseek-chat.
DEEPSEEK_API_KEY=

# Gemini — ключ бесплатно на aistudio.google.com («Get API key», карта не нужна).
# Используется при AFINA_AI_PROVIDER=google. Модель по умолчанию: gemini-2.5-flash.
GOOGLE_GENERATIVE_AI_API_KEY=

# Переопределение модели — отдельно по провайдеру, чтобы стейл-значение одного
# не ломало другой при переключении.
# DEEPSEEK_MODEL: deepseek-chat (дефолт) | deepseek-v4-flash | deepseek-reasoner
DEEPSEEK_MODEL=
# GOOGLE_MODEL: gemini-2.5-flash (дефолт) | gemini-2.5-pro | …
GOOGLE_MODEL=
# AFINA_AI_MODEL — legacy, применяется ТОЛЬКО к google (back-compat). Для
# deepseek не используется. Предпочитайте GOOGLE_MODEL/DEEPSEEK_MODEL.
AFINA_AI_MODEL=
